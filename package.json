{
  "name": "subplug",
  "version": "0.0.1",
  "type": "module",
  "description": "Monitor other opencode sessions and subagents, overlaid with the coordination/ claim registry, with queue-only addressed comms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfisatypedef/subplug.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "monitoring",
    "coordination"
  ],
  "engines": {
    "opencode": ">=1.18 <2",
    "bun": ">=1.3"
  },
  "exports": {
    "./server": {
      "import": "./src/server/index.ts",
      "types": "./src/server/index.ts"
    },
    "./tui": {
      "import": "./src/tui/index.tsx",
      "types": "./src/tui/index.tsx"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "harness": "bun run scripts/dev-harness.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.33"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.33",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
