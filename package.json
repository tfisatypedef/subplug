{
  "name": "subplug",
  "version": "0.3.0",
  "type": "module",
  "description": "Monitor other opencode sessions and subagents, overlaid with the coordination/ claim registry, with queue-only addressed comms.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfisatypedef/subplug.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "monitoring",
    "coordination"
  ],
  "homepage": "https://github.com/tfisatypedef/subplug#readme",
  "bugs": {
    "url": "https://github.com/tfisatypedef/subplug/issues"
  },
  "author": "tfisatypedef (https://github.com/tfisatypedef)",
  "engines": {
    "opencode": ">=2",
    "bun": ">=1.3"
  },
  "exports": {
    ".": {
      "import": "./src/server/index.ts",
      "types": "./src/server/index.ts"
    },
    "./server": {
      "import": "./src/server/index.ts",
      "types": "./src/server/index.ts"
    },
    "./tui": {
      "import": "./src/tui/index.tsx",
      "types": "./src/tui/index.tsx"
    }
  },
  "files": [
    "server.ts",
    "tui.tsx",
    "src",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "harness": "bun run scripts/dev-harness.ts",
    "canary": "bun run scripts/canary.ts",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.19"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
